# Copia este archivo a `.env` y completa con tu cadena de conexión.
# Destino de despliegue: Supabase (PostgreSQL).
# Formato Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Modo transaccional/SSL se recomienda añadir ?pgbouncer=true&connection_limit=1 en el pooler.
DATABASE_URL="postgresql://postgres:password@localhost:5432/andina_cargo?schema=public"
